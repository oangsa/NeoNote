import { ScrollView } from "std-widgets.slint";

component CommandButton inherits Rectangle {
    in property <string> text;
    in property <brush> background-color;
    in property <brush> hover-color;
    in property <brush> command-border-color;
    in property <brush> text-color;
    in property <TextHorizontalAlignment> text-alignment: center;
    in property <length> text-padding-left: 0px;
    callback clicked();

    height: 30px;
    min-width: 64px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.command-border-color;
    background: touch.has-hover ? root.hover-color : root.background-color;

    HorizontalLayout {
        padding-left: root.text-padding-left;
        Text {
            text: root.text;
            color: root.text-color;
            font-size: 13px;
            horizontal-alignment: root.text-alignment;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component NumericSettingRow inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <brush> row-background;
    in property <brush> row-hover;
    in property <brush> row-border;
    in property <brush> row-text;
    in property <brush> row-text-muted;
    callback decrement();
    callback increment();

    height: 46px;
    border-radius: 4px;
    background: root.row-background;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;

        Text {
            text: root.title;
            color: root.row-text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 190px;
                height: 30px;

                HorizontalLayout {
                    spacing: 10px;

                    CommandButton {
                        width: 64px;
                        text: "-";
                        background-color: root.row-background;
                        hover-color: root.row-hover;
                        command-border-color: root.row-border;
                        text-color: root.row-text;
                        clicked => { root.decrement(); }
                    }

                    Text {
                        text: root.value;
                        color: root.row-text-muted;
                        font-size: 13px;
                        width: 42px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    CommandButton {
                        width: 64px;
                        text: "+";
                        background-color: root.row-background;
                        hover-color: root.row-hover;
                        command-border-color: root.row-border;
                        text-color: root.row-text;
                        clicked => { root.increment(); }
                    }
                }
            }
        }
    }
}

component ToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> checked;
    in property <brush> row-background;
    in property <brush> row-hover;
    in property <brush> row-border;
    in property <brush> row-text;
    in property <brush> row-text-muted;
    in property <brush> row-accent;
    callback toggled();

    height: 48px;
    border-radius: 4px;
    background: touch.has-hover ? root.row-hover : root.row-background;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.title;
                color: root.row-text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                text: root.detail;
                color: root.row-text-muted;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 38px;
                height: 20px;
                border-radius: 10px;
                background: root.checked ? root.row-accent : root.row-border;

                Rectangle {
                    x: root.checked ? 20px : 2px;
                    y: 2px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: root.row-background;
                }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

export struct EditorLine {
    number: int,
    text: string,
    is-cursor-line: bool,
    selected-prefix: string,
    selected-text: string,
    is-search-match: bool,
    cursor-column: int,
    cursor-prefix: string,
    cursor-cell: string,
    cursor-suffix: string,
    cursor-block: bool,
}

export struct ThemeItem {
    index: int,
    name: string,
    variant: string,
    author: string,
    is-active: bool,
    is-preview: bool,
}

export struct SettingsData {
    language-label: string,
    font-family: string,
    font-size: float,
    font-size-label: string,
    line-height: float,
    line-height-label: string,
    tab-size: int,
    tab-size-label: string,
    word-wrap: bool,
    sync-clipboard: bool,
    restore-last-session: bool,
    show-launcher-on-startup: bool,
    remember-window-geometry: bool,
    blur-behind: bool,
    window-opacity: int,
    window-opacity-label: string,
}

export struct DocumentTab {
    index: int,
    title: string,
    is-active: bool,
    is-modified: bool,
}

export struct UiText {
    app-title: string,
    launcher-hint: string,
    files-menu: string,
    new-file: string,
    open-file: string,
    save-file: string,
    save-as-file: string,
    settings-title: string,
    settings-close: string,
    themes-title: string,
    theme-cancel: string,
    theme-preview: string,
    theme-apply: string,
    theme-active: string,
    appearance-section: string,
    appearance-themes: string,
    editor-section: string,
    language: string,
    font-size: string,
    line-height: string,
    tab-size: string,
    word-wrap: string,
    word-wrap-detail: string,
    vim-section: string,
    sync-clipboard: string,
    sync-clipboard-detail: string,
    startup-section: string,
    restore-last-session: string,
    restore-last-session-detail: string,
    show-launcher-on-startup: string,
    show-launcher-on-startup-detail: string,
    window-section: string,
    remember-window-geometry: string,
    remember-window-geometry-detail: string,
    blur-behind: string,
    blur-behind-detail: string,
    window-opacity: string,
}

export component AppWindow inherits Window {
    title: root.ui-text.app-title;
    preferred-width: 1280px;
    preferred-height: 800px;

    in property <string> file-title: "Untitled";
    in property <string> file-path: "";
    in property <[EditorLine]> editor-lines;
    in property <[DocumentTab]> document-tabs;
    in property <string> status-text: "No note open";
    in property <string> status-right: "";
    in property <string> mode-text: "NORMAL";
    in property <int> cursor-line: 0;
    in property <int> cursor-column: 0;
    in property <string> cursor-prefix: "";
    in property <string> cursor-cell: " ";
    in property <string> cursor-suffix: "";
    in property <bool> cursor-block: true;
    in property <length> editor-left-padding: 14px;
    in property <float> editor-line-height: 17;
    in property <float> editor-font-size: 14;
    in property <length> cursor-x-adjust: -1px;
    in property <string> editor-font-family: "Consolas";
    in property <string> message: "";
    in property <bool> has-document: false;
    in property <bool> show-theme-panel: false;
    in property <bool> show-settings-panel: false;
    in property <[ThemeItem]> theme-items;
    in property <SettingsData> settings;
    in property <UiText> ui-text;
    in property <brush> theme-background: #0f1117;
    in property <brush> theme-background-alt: #161922;
    in property <brush> theme-surface: #1d2430;
    in property <brush> theme-border: #303848;
    in property <brush> theme-text: #d7dae0;
    in property <brush> theme-text-muted: #7f8490;
    in property <brush> theme-accent-primary: #7aa2f7;
    in property <brush> theme-accent-secondary: #bb9af7;
    in property <brush> theme-success: #9ece6a;
    in property <brush> theme-warning: #e0af68;
    in property <brush> theme-error: #f7768e;
    in property <brush> theme-cursor: #c0caf5;
    in property <brush> mode-color: #7aa2f7;

    callback new-file();
    callback open-file();
    callback save-file();
    callback save-as-file();
    callback previous-document();
    callback next-document();
    callback switch-to-document(int);
    callback close-document(int);
    callback open-theme-panel();
    callback theme-preview(int);
    callback theme-apply(int);
    callback theme-panel-close();
    callback open-settings-panel();
    callback settings-panel-close();
    callback settings-adjust-font-size(int);
    callback settings-adjust-line-height(int);
    callback settings-adjust-tab-size(int);
    callback settings-cycle-language(int);
    callback settings-adjust-window-opacity(int);
    callback settings-toggle-word-wrap();
    callback settings-toggle-sync-clipboard();
    callback settings-toggle-restore-last-session();
    callback settings-toggle-show-launcher-on-startup();
    callback settings-toggle-remember-window-geometry();
    callback settings-toggle-blur-behind();
    callback editor-key(string);
    callback editor-pointer-event(int, float, string);

    public function focus-editor() {
        editor-focus.focus();
    }

    public function scroll-to-cursor() {
        let cursor_y = root.cursor-line * root.editor-line-height * 1px;
        let visible_height = editor-scroll.height;
        let current_scroll_y = -editor-scroll.viewport-y;
        
        if (cursor_y < current_scroll_y) {
            editor-scroll.viewport-y = -cursor_y;
        } else if (cursor_y + root.editor-line-height * 1px > current_scroll_y + visible_height) {
            editor-scroll.viewport-y = -(cursor_y + root.editor-line-height * 1px - visible_height);
        }
    }

    background: root.theme-background;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 38px;
            background: root.theme-background-alt;
            border-width: 0px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 4px;
                        height: 20px;
                        border-radius: 2px;
                        background: root.mode-color;
                    }
                }

                Text {
                    text: root.ui-text.app-title;
                    color: root.theme-text;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 1px;
                    background: root.theme-border;
                }

                VerticalLayout {
                    alignment: center;
                    
                    files-btn := Rectangle {
                        width: 64px;
                        height: 30px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.theme-border;
                        background: files-touch.has-hover ? root.theme-border : root.theme-surface;

                        Text {
                            text: root.ui-text.files-menu;
                            color: root.theme-text;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        files-touch := TouchArea {
                            clicked => {
                                files-popup.show();
                            }
                        }

                        files-popup := PopupWindow {
                            x: 0px;
                            y: 34px;
                            width: 140px;

                            Rectangle {
                                background: root.theme-surface;
                                border-color: root.theme-border;
                                border-width: 1px;
                                border-radius: 4px;
                                drop-shadow-color: root.theme-background;
                                drop-shadow-blur: 8px;
                                drop-shadow-offset-y: 4px;

                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 2px;

                                    CommandButton {
                                        text: root.ui-text.new-file;
                                        text-alignment: left;
                                        text-padding-left: 12px;
                                        background-color: root.theme-surface;
                                        hover-color: root.theme-border;
                                        command-border-color: transparent;
                                        text-color: root.theme-text;
                                        clicked => { root.new-file(); }
                                    }
                                    CommandButton {
                                        text: root.ui-text.open-file;
                                        text-alignment: left;
                                        text-padding-left: 12px;
                                        background-color: root.theme-surface;
                                        hover-color: root.theme-border;
                                        command-border-color: transparent;
                                        text-color: root.theme-text;
                                        clicked => { root.open-file(); }
                                    }
                                    Rectangle { height: 1px; background: root.theme-border; }
                                    CommandButton {
                                        text: root.ui-text.save-file;
                                        text-alignment: left;
                                        text-padding-left: 12px;
                                        background-color: root.theme-surface;
                                        hover-color: root.theme-border;
                                        command-border-color: transparent;
                                        text-color: root.theme-text;
                                        clicked => { root.save-file(); }
                                    }
                                    CommandButton {
                                        text: root.ui-text.save-as-file;
                                        text-alignment: left;
                                        text-padding-left: 12px;
                                        background-color: root.theme-surface;
                                        hover-color: root.theme-border;
                                        command-border-color: transparent;
                                        text-color: root.theme-text;
                                        clicked => { root.save-as-file(); }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;
                    
                    CommandButton {
                        width: 32px;
                        text: "⚙";
                        background-color: root.theme-surface;
                        hover-color: root.theme-border;
                        command-border-color: root.theme-border;
                        text-color: root.theme-text;
                        clicked => { root.open-settings-panel(); }
                    }
                }
            }
        }

        Rectangle {
            height: 28px;
            background: root.theme-surface;
            border-color: root.theme-border;
            border-width: 0px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                ScrollView {
                    horizontal-stretch: 1;
                    height: 28px;
                    
                    HorizontalLayout {
                        spacing: 2px;
                        
                        for tab in root.document-tabs: Rectangle {
                            width: 140px;
                            height: 28px;
                            background: tab.is-active ? root.theme-background : root.theme-surface;
                            border-top-left-radius: 6px;
                            border-top-right-radius: 6px;
                            
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 4px;
                                spacing: 4px;
                                
                                Text {
                                    horizontal-stretch: 1;
                                    text: tab.title + (tab.is-modified ? " •" : "");
                                    color: tab.is-active ? root.theme-text : root.theme-text-muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    
                                    close-btn := Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 4px;
                                        background: close-touch.has-hover ? root.theme-border : transparent;

                                        Text {
                                            text: "x";
                                            font-size: 12px;
                                            color: tab.is-active ? root.theme-text : root.theme-text-muted;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        close-touch := TouchArea {
                                            clicked => {
                                                root.close-document(tab.index);
                                            }
                                        }
                                    }
                                }
                            }
                            
                            TouchArea {
                                width: parent.width - 24px;
                                clicked => {
                                    root.switch-to-document(tab.index);
                                }
                            }
                        }
                    }
                }

                Text {
                    text: root.message;
                    color: root.message == "" ? root.theme-text-muted : root.theme-success;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            background: root.theme-background;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            editor-focus := FocusScope {
                width: 100%;
                height: 100%;

                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.editor-key("escape");
                    } else if (event.text == Key.Return) {
                        root.editor-key("return");
                    } else if (event.text == Key.Backspace) {
                        root.editor-key("backspace");
                    } else if (event.text == Key.Delete) {
                        root.editor-key("delete");
                    } else if (event.text == Key.LeftArrow) {
                        root.editor-key("left");
                    } else if (event.text == Key.RightArrow) {
                        root.editor-key("right");
                    } else if (event.text == Key.UpArrow) {
                        root.editor-key("up");
                    } else if (event.text == Key.DownArrow) {
                        root.editor-key("down");
                    } else if (event.modifiers.control && event.text == "r") {
                        root.editor-key("ctrl+r");
                    } else if (event.modifiers.control && event.text == "=") {
                        root.editor-key("ctrl+=");
                    } else if (event.modifiers.control && event.text == "+") {
                        root.editor-key("ctrl++");
                    } else if (event.modifiers.control && event.text == "-") {
                        root.editor-key("ctrl+-");
                    } else if (event.text == Key.Tab) {
                        root.editor-key("tab");
                    } else if (event.text == Key.Shift || event.text == Key.Control || event.text == Key.Alt || event.text == Key.Meta) {
                        // ignore modifier keys to prevent them from entering the buffer as unprintable characters
                    } else {
                        root.editor-key(event.text);
                    }

                    return accept;
                }

                editor-viewport := Rectangle {
                    x: 0px;
                    y: 14px;
                    width: 100%;
                    height: parent.height - 28px;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 58px;
                        height: 100%;
                        background: root.theme-background-alt;
                    }

                    Rectangle {
                        x: 58px;
                        y: 0px;
                        width: parent.width - 58px;
                        height: 100%;
                        background: root.theme-background;
                    }

                    Text {
                        x: 58px + root.editor-left-padding;
                        y: 0px;
                        width: parent.width - 58px - (root.editor-left-padding * 2);
                        height: parent.height;
                        text: root.ui-text.launcher-hint;
                        color: root.theme-text-muted;
                        font-family: root.editor-font-family;
                        font-size: root.editor-font-size * 1px;
                        visible: !root.has-document;
                    }

                    editor-scroll := ScrollView {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        visible: root.has-document;

                        VerticalLayout {
                            width: 100%;
                            spacing: 0px;

                            for line in root.editor-lines: Rectangle {
                                height: root.editor-line-height * 1px;
                                width: 100%;
                                background: line.is-search-match ? root.theme-warning.with_alpha(0.16) : (line.is-cursor-line ? root.theme-surface.with_alpha(0.28) : transparent);

                                selection-prefix-measure := Text {
                                    text: line.selected-prefix;
                                    font-family: root.editor-font-family;
                                    font-size: root.editor-font-size * 1px;
                                    visible: false;
                                }

                                selection-measure := Text {
                                    text: line.selected-text;
                                    font-family: root.editor-font-family;
                                    font-size: root.editor-font-size * 1px;
                                    visible: false;
                                }

                                Rectangle {
                                    x: 58px + root.editor-left-padding + (line.selected-prefix == "" ? 0px : selection-prefix-measure.preferred-width);
                                    width: line.selected-text == "" ? 0px : selection-measure.preferred-width;
                                    height: root.editor-line-height * 1px;
                                    background: root.theme-accent-primary.with_alpha(0.18);
                                }

                                Text {
                                    x: 0px;
                                    y: 0px;
                                    width: 48px;
                                    height: root.editor-line-height * 1px;
                                    text: line.number;
                                    color: root.theme-text-muted;
                                    font-family: root.editor-font-family;
                                    font-size: root.editor-font-size * 1px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                prefix-measure := Text {
                                    x: 58px + root.editor-left-padding;
                                    y: 0px;
                                    height: root.editor-line-height * 1px;
                                    text: line.cursor-prefix;
                                    color: transparent;
                                    font-family: root.editor-font-family;
                                    font-size: root.editor-font-size * 1px;
                                    vertical-alignment: center;
                                    wrap: no-wrap;
                                }

                                cursor-cell-measure := Text {
                                    x: 58px + root.editor-left-padding;
                                    y: 0px;
                                    height: root.editor-line-height * 1px;
                                    text: line.cursor-cell;
                                    color: transparent;
                                    font-family: root.editor-font-family;
                                    font-size: root.editor-font-size * 1px;
                                    vertical-alignment: center;
                                    wrap: no-wrap;
                                }

                                Rectangle {
                                    x: 58px + root.editor-left-padding + (line.cursor-prefix == "" ? 0px : prefix-measure.preferred-width) + root.cursor-x-adjust;
                                    y: 0px;
                                    height: root.editor-line-height * 1px;
                                    width: line.is-cursor-line ? (line.cursor-block ? max(cursor-cell-measure.preferred-width - root.cursor-x-adjust, 2px) : 2px) : 0px;
                                    background: line.cursor-block ? root.theme-cursor.with_alpha(0.58) : root.mode-color;
                                }

                                Text {
                                    x: 58px + root.editor-left-padding;
                                    y: 0px;
                                    width: parent.width - 58px - (root.editor-left-padding * 2);
                                    height: root.editor-line-height * 1px;
                                    text: line.text;
                                    color: root.theme-text;
                                    font-family: root.editor-font-family;
                                    font-size: root.editor-font-size * 1px;
                                    vertical-alignment: center;
                                    wrap: no-wrap;
                                }


                            }
                        }
                    }
                }
            }

                    editor-touch := TouchArea {
                        width: parent.width - 15px; // Leave room for scrollbar
                        height: 100%;
                        clicked => {
                            editor-focus.focus();
                        }
                        scroll-event(event) => {
                            if (event.modifiers.control) {
                                if (event.delta-y > 0) {
                                    root.editor-key("ctrl+scroll-up");
                                } else if (event.delta-y < 0) {
                                    root.editor-key("ctrl+scroll-down");
                                }
                                return accept;
                            }
                            return reject;
                        }

                        pointer-event(event) => {
                            let physical_y = editor-touch.mouse-y - editor-scroll.viewport-y;
                            let line_index = Math.floor(physical_y / (root.editor-line-height * 1px));
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                root.editor-pointer-event(line_index, (editor-touch.mouse-x - 58px - root.editor-left-padding) / 1px, "down");
                            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                root.editor-pointer-event(line_index, (editor-touch.mouse-x - 58px - root.editor-left-padding) / 1px, "up");
                            }
                        }

                        moved => {
                            if (editor-touch.pressed) {
                                let physical_y = editor-touch.mouse-y - editor-scroll.viewport-y;
                                let line_index = Math.floor(physical_y / (root.editor-line-height * 1px));
                                root.editor-pointer-event(line_index, (editor-touch.mouse-x - 58px - root.editor-left-padding) / 1px, "move");
                            }
                        }

                        double-clicked => {
                            let physical_y = editor-touch.mouse-y - editor-scroll.viewport-y;
                            let line_index = Math.floor(physical_y / (root.editor-line-height * 1px));
                            root.editor-pointer-event(line_index, (editor-touch.mouse-x - 58px - root.editor-left-padding) / 1px, "double_click");
                        }
                    }
        }

        Rectangle {
            height: 26px;
            background: root.theme-background-alt;

            HorizontalLayout {
                spacing: 0px;

                Rectangle {
                    width: 108px;
                    background: root.mode-color;

                    Text {
                        text: root.mode-text;
                        color: root.theme-background;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.status-text;
                    color: root.theme-text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: left;
                }

                Text {
                    text: root.status-right;
                    color: root.theme-text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        visible: root.show-theme-panel;
        background: root.theme-background.with_alpha(0.68);

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.theme-panel-close();
            }
        }

        Rectangle {
            width: min(parent.width - 48px, 560px);
            height: min(parent.height - 80px, 520px);
            x: (parent.width - self.width) / 2;
            y: 56px;
            border-width: 1px;
            border-color: root.theme-border;
            border-radius: 6px;
            background: root.theme-surface;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    padding-right: 16px;
                    height: 32px;
                    spacing: 8px;

                    Text {
                        text: root.ui-text.themes-title;
                        color: root.theme-text;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    CommandButton {
                        text: root.ui-text.theme-cancel;
                        background-color: root.theme-background-alt;
                        hover-color: root.theme-border;
                        command-border-color: root.theme-border;
                        text-color: root.theme-text-muted;
                        clicked => { root.theme-panel-close(); }
                    }
                }

                HorizontalLayout {
                    padding-right: 16px;
                    Rectangle {
                        height: 1px;
                        background: root.theme-border;
                    }
                }

                ScrollView {
                    VerticalLayout {
                    padding-right: 16px;
                    spacing: 6px;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    for item in root.theme-items: Rectangle {
                        height: 56px;
                        border-radius: 4px;
                        border-width: item.is-preview ? 1px : 0px;
                        border-color: root.theme-accent-primary;
                        background: item.is-preview ? root.theme-background-alt : (item.is-active ? root.theme-background-alt.with_alpha(0.72) : root.theme-background);

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.theme-preview(item.index);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 10px;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 4px;
                                    height: 34px;
                                    border-radius: 2px;
                                    background: item.is-preview ? root.theme-accent-primary : (item.is-active ? root.theme-success : root.theme-border);
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                alignment: center;

                                Text {
                                    text: item.name;
                                    color: root.theme-text;
                                    font-size: 14px;
                                    font-weight: item.is-active ? 700 : 500;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Text {
                                    text: item.variant + "  |  " + item.author;
                                    color: root.theme-text-muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 202px;
                                    height: 30px;

                                    HorizontalLayout {
                                        spacing: 10px;

                                        Text {
                                            text: item.is-preview ? root.ui-text.theme-preview : (item.is-active ? root.ui-text.theme-active : "");
                                            color: item.is-active ? root.theme-success : root.theme-accent-primary;
                                            font-size: 12px;
                                            width: 54px;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }

                                        CommandButton {
                                            width: 64px;
                                            text: root.ui-text.theme-preview;
                                            background-color: root.theme-background-alt;
                                            hover-color: root.theme-border;
                                            command-border-color: root.theme-border;
                                            text-color: root.theme-text-muted;
                                            clicked => { root.theme-preview(item.index); }
                                        }

                                        CommandButton {
                                            width: 64px;
                                            text: root.ui-text.theme-apply;
                                            background-color: item.is-active ? root.theme-background-alt : root.theme-accent-primary;
                                            hover-color: root.theme-border;
                                            command-border-color: item.is-active ? root.theme-border : root.theme-accent-primary;
                                            text-color: item.is-active ? root.theme-text-muted : root.theme-background;
                                            clicked => { root.theme-apply(item.index); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        visible: root.show-settings-panel;
        background: root.theme-background.with_alpha(0.68);

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.settings-panel-close();
            }
        }

        Rectangle {
            width: min(parent.width - 48px, 600px);
            height: min(parent.height - 80px, 560px);
            x: (parent.width - self.width) / 2;
            y: 56px;
            border-width: 1px;
            border-color: root.theme-border;
            border-radius: 6px;
            background: root.theme-surface;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    padding-right: 16px;
                    height: 32px;
                    spacing: 8px;

                    Text {
                        text: root.ui-text.settings-title;
                        color: root.theme-text;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    CommandButton {
                        text: root.ui-text.settings-close;
                        background-color: root.theme-background-alt;
                        hover-color: root.theme-border;
                        command-border-color: root.theme-border;
                        text-color: root.theme-text-muted;
                        clicked => { root.settings-panel-close(); }
                    }
                }

                HorizontalLayout {
                    padding-right: 16px;
                    Rectangle {
                        height: 1px;
                        background: root.theme-border;
                    }
                }

                ScrollView {
                    VerticalLayout {
                        padding-right: 16px;
                        spacing: 12px;

                Text {
                    text: root.ui-text.appearance-section;
                    color: root.theme-text-muted;
                    font-size: 12px;
                    font-weight: 700;
                }

                Rectangle {
                    height: 46px;
                    border-radius: 4px;
                    background: touch-theme.has-hover ? root.theme-border : root.theme-background;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;

                        Text {
                            text: root.ui-text.appearance-themes;
                            color: root.theme-text;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    touch-theme := TouchArea {
                        clicked => {
                            root.open-theme-panel();
                        }
                    }
                }

                Text {
                    text: root.ui-text.editor-section;
                    color: root.theme-text-muted;
                    font-size: 12px;
                    font-weight: 700;
                }

                NumericSettingRow {
                    title: root.ui-text.language;
                    value: root.settings.language-label;
                    row-background: root.theme-background;
                    row-hover: root.theme-border;
                    row-border: root.theme-border;
                    row-text: root.theme-text;
                    row-text-muted: root.theme-text-muted;
                    decrement => { root.settings-cycle-language(-1); }
                    increment => { root.settings-cycle-language(1); }
                }

                NumericSettingRow {
                    title: root.ui-text.font-size;
                    value: root.settings.font-size-label;
                    row-background: root.theme-background;
                    row-hover: root.theme-border;
                    row-border: root.theme-border;
                    row-text: root.theme-text;
                    row-text-muted: root.theme-text-muted;
                    decrement => { root.settings-adjust-font-size(-1); }
                    increment => { root.settings-adjust-font-size(1); }
                }

                NumericSettingRow {
                    title: root.ui-text.line-height;
                    value: root.settings.line-height-label;
                    row-background: root.theme-background;
                    row-hover: root.theme-border;
                    row-border: root.theme-border;
                    row-text: root.theme-text;
                    row-text-muted: root.theme-text-muted;
                    decrement => { root.settings-adjust-line-height(-1); }
                    increment => { root.settings-adjust-line-height(1); }
                }

                NumericSettingRow {
                    title: root.ui-text.tab-size;
                    value: root.settings.tab-size-label;
                    row-background: root.theme-background;
                    row-hover: root.theme-border;
                    row-border: root.theme-border;
                    row-text: root.theme-text;
                    row-text-muted: root.theme-text-muted;
                    decrement => { root.settings-adjust-tab-size(-1); }
                    increment => { root.settings-adjust-tab-size(1); }
                }

                ToggleRow {
                    title: root.ui-text.word-wrap;
                    detail: root.ui-text.word-wrap-detail;
                    checked: root.settings.word-wrap;
                    row-background: root.theme-background;
                    row-hover: root.theme-background-alt;
                    row-border: root.theme-border;
                    row-text: root.theme-text;
                    row-text-muted: root.theme-text-muted;
                    row-accent: root.theme-accent-primary;
                    toggled => { root.settings-toggle-word-wrap(); }
                }

                Text {
                    text: root.ui-text.vim-section;
                    color: root.theme-text-muted;
                    font-size: 12px;
                    font-weight: 700;
                }

                ToggleRow {
                    title: root.ui-text.sync-clipboard;
                    detail: root.ui-text.sync-clipboard-detail;
                    checked: root.settings.sync-clipboard;
                    row-background: root.theme-background;
                    row-hover: root.theme-background-alt;
                    row-border: root.theme-border;
                    row-text: root.theme-text;
                    row-text-muted: root.theme-text-muted;
                    row-accent: root.theme-accent-primary;
                    toggled => { root.settings-toggle-sync-clipboard(); }
                }

                Text {
                    text: root.ui-text.startup-section;
                    color: root.theme-text-muted;
                    font-size: 12px;
                    font-weight: 700;
                }

                ToggleRow {
                    title: root.ui-text.restore-last-session;
                    detail: root.ui-text.restore-last-session-detail;
                    checked: root.settings.restore-last-session;
                    row-background: root.theme-background;
                    row-hover: root.theme-background-alt;
                    row-border: root.theme-border;
                    row-text: root.theme-text;
                    row-text-muted: root.theme-text-muted;
                    row-accent: root.theme-accent-primary;
                    toggled => { root.settings-toggle-restore-last-session(); }
                }

                ToggleRow {
                    title: root.ui-text.show-launcher-on-startup;
                    detail: root.ui-text.show-launcher-on-startup-detail;
                    checked: root.settings.show-launcher-on-startup;
                    row-background: root.theme-background;
                    row-hover: root.theme-background-alt;
                    row-border: root.theme-border;
                    row-text: root.theme-text;
                    row-text-muted: root.theme-text-muted;
                    row-accent: root.theme-accent-primary;
                    toggled => { root.settings-toggle-show-launcher-on-startup(); }
                }

                Text {
                    text: root.ui-text.window-section;
                    color: root.theme-text-muted;
                    font-size: 12px;
                    font-weight: 700;
                }

                ToggleRow {
                    title: root.ui-text.remember-window-geometry;
                    detail: root.ui-text.remember-window-geometry-detail;
                    checked: root.settings.remember-window-geometry;
                    row-background: root.theme-background;
                    row-hover: root.theme-background-alt;
                    row-border: root.theme-border;
                    row-text: root.theme-text;
                    row-text-muted: root.theme-text-muted;
                    row-accent: root.theme-accent-primary;
                    toggled => { root.settings-toggle-remember-window-geometry(); }
                }

                ToggleRow {
                    title: root.ui-text.blur-behind;
                    detail: root.ui-text.blur-behind-detail;
                    checked: root.settings.blur-behind;
                    row-background: root.theme-background;
                    row-hover: root.theme-background-alt;
                    row-border: root.theme-border;
                    row-text: root.theme-text;
                    row-text-muted: root.theme-text-muted;
                    row-accent: root.theme-accent-primary;
                    toggled => { root.settings-toggle-blur-behind(); }
                }

                NumericSettingRow {
                    title: root.ui-text.window-opacity;
                    value: root.settings.window-opacity-label;
                    row-background: root.theme-background;
                    row-hover: root.theme-border;
                    row-border: root.theme-border;
                    row-text: root.theme-text;
                    row-text-muted: root.theme-text-muted;
                    decrement => { root.settings-adjust-window-opacity(-5); }
                    increment => { root.settings-adjust-window-opacity(5); }
                }
                }
                }
            }
        }
    }
}
