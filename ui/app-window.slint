import { ScrollView } from "std-widgets.slint";

component CommandButton inherits Rectangle {
    in property <string> text;
    in property <brush> background-color;
    in property <brush> hover-color;
    in property <brush> command-border-color;
    in property <brush> text-color;
    in property <bool> is-primary: false;
    in property <TextHorizontalAlignment> text-alignment: center;
    in property <length> text-padding-left: 0px;
    callback clicked();

    height: 30px;
    min-width: 64px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.command-border-color;
    background: touch.has-hover ? root.hover-color : root.background-color;
    animate background {
        duration: 140ms;
        easing: ease-out;
    }
    animate border-color {
        duration: 140ms;
        easing: ease-out;
    }

    HorizontalLayout {
        padding-left: root.text-padding-left;
        Text {
            text: root.text;
            color: root.text-color;
            font-size: 13px;
            horizontal-alignment: root.text-alignment;
            vertical-alignment: center;
            animate color {
                duration: 140ms;
                easing: ease-out;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component SearchField inherits Rectangle {
    in property <string> placeholder;
    in property <brush> field-background;
    in property <brush> field-border;
    in property <brush> field-text-muted;

    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.field-border.with_alpha(0.65);
    background: root.field-background;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            text: "⌕";
            color: root.field-text-muted;
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            text: root.placeholder;
            color: root.field-text-muted;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

component CursorSmearDemoCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> code;
    in property <string> editor-font;
    in property <brush> card-background;
    in property <brush> card-border;
    in property <brush> card-text;
    in property <brush> card-muted;

    border-radius: 8px;
    border-width: 1px;
    border-color: root.card-border.with_alpha(0.45);
    background: root.card-background;
    clip: true;

    VerticalLayout {
        padding: 12px;
        spacing: 5px;

        Text {
            text: root.title;
            color: root.card-text;
            font-size: 12px;
            font-weight: 700;
        }

        Text {
            text: root.subtitle;
            color: root.card-muted;
            font-size: 10px;
        }

        Text {
            text: root.code;
            color: root.card-text;
            font-family: root.editor-font;
            font-size: 10px;
            vertical-stretch: 1;
        }
    }
}

component NumericSettingRow inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <brush> row-background;
    in property <brush> row-hover;
    in property <brush> row-border;
    in property <brush> row-text;
    in property <brush> row-text-muted;
    callback decrement();
    callback increment();

    height: 48px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.row-border.with_alpha(0.45);
    background: root.row-background;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;

        Text {
            text: root.title;
            color: root.row-text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 190px;
                height: 30px;

                HorizontalLayout {
                    spacing: 10px;

                    CommandButton {
                        width: 64px;
                        text: "-";
                        background-color: root.row-background;
                        hover-color: root.row-hover;
                        command-border-color: root.row-border;
                        text-color: root.row-text;
                        clicked => { root.decrement(); }
                                }

                                Text {
                        text: root.value;
                        color: root.row-text-muted;
                        font-size: 13px;
                        width: 42px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    CommandButton {
                        width: 64px;
                        text: "+";
                        background-color: root.row-background;
                        hover-color: root.row-hover;
                        command-border-color: root.row-border;
                        text-color: root.row-text;
                        clicked => { root.increment(); }
                    }
                }
            }
        }
    }
}

component ToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> checked;
    in property <brush> row-background;
    in property <brush> row-hover;
    in property <brush> row-border;
    in property <brush> row-text;
    in property <brush> row-text-muted;
    in property <brush> row-accent;
    callback toggled();

    height: 52px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.row-border.with_alpha(0.45);
    background: touch.has-hover ? root.row-hover : root.row-background;
    animate background {
        duration: 160ms;
        easing: ease-out;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.title;
                color: root.row-text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                text: root.detail;
                color: root.row-text-muted;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 38px;
                height: 20px;
                border-radius: 10px;
                background: root.checked ? root.row-accent : root.row-border;
                animate background {
                    duration: 160ms;
                    easing: ease-in-out;
                }

                Rectangle {
                    x: root.checked ? 20px : 2px;
                    y: 2px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: root.row-background;
                    animate x {
                        duration: 160ms;
                        easing: ease-in-out;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

component SettingsNavItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> active: false;
    in property <brush> background-color;
    in property <brush> hover-color;
    in property <brush> active-color;
    in property <brush> text-color;
    in property <brush> muted-color;
    callback clicked();

    height: 34px;
    border-radius: 6px;
    background: root.active ? root.active-color : (touch.has-hover ? root.hover-color : transparent);
    animate background {
        duration: 140ms;
        easing: ease-out;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            text: root.icon;
            color: root.active ? root.text-color : root.muted-color;
            font-size: 14px;
            width: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color {
                duration: 140ms;
                easing: ease-out;
            }
        }

        Text {
            text: root.text;
            color: root.active ? root.text-color : root.muted-color;
            font-size: 13px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
            overflow: elide;
            animate color {
                duration: 140ms;
                easing: ease-out;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export enum SelectionKind {
    character,
    line,
    block,
}

export struct SelectionHighlightSegment {
    visible-line-index: int,
    start-column: int,
    end-column: int,
    right-overshoot-cells: float,
    round-top-left: bool,
    round-top-right: bool,
    round-bottom-left: bool,
    round-bottom-right: bool,
    kind: SelectionKind,
}

export struct SelectionHighlightShape {
    visible-line-index: int,
    top-line: float,
    left-column: float,
    width-cells: float,
    height-lines: float,
    path-data: string,
    kind: SelectionKind,
}

export struct EditorLine {
    number: int,
    text: string,
    is-cursor-line: bool,
    selected-prefix: string,
    selected-text: string,
    is-search-match: bool,
    cursor-column: int,
    cursor-prefix: string,
    cursor-cell: string,
    cursor-suffix: string,
    cursor-block: bool,
    is-line-selected: bool,
    selection-continues-before: bool,
    selection-continues-after: bool,
    selection-start-column: int,
    selection-end-column: int,
    selection-render-end-column: int,
}

export struct ThemeItem {
    index: int,
    name: string,
    variant: string,
    author: string,
    is-active: bool,
    is-preview: bool,
}

export struct SettingsData {
    language-label: string,
    font-family: string,
    font-size: float,
    font-size-label: string,
    line-height: float,
    line-height-label: string,
    tab-size: int,
    tab-size-label: string,
    word-wrap: bool,
    sync-clipboard: bool,
    restore-last-session: bool,
    show-launcher-on-startup: bool,
    remember-window-geometry: bool,
    blur-behind: bool,
    window-opacity: int,
    window-opacity-label: string,
    enable-mica: bool,
    enable-animations: bool,
    enable-cursor-glide: bool,
    enable-smooth-scroll: bool,
    enable-cursor-blink: bool,
    enable-cursor-smear: bool,
}

export struct DocumentTab {
    index: int,
    title: string,
    is-active: bool,
    is-modified: bool,
}

export struct UiText {
    app-title: string,
    launcher-hint: string,
    files-menu: string,
    new-file: string,
    open-file: string,
    save-file: string,
    save-as-file: string,
    settings-title: string,
    settings-close: string,
    themes-title: string,
    theme-cancel: string,
    theme-preview: string,
    theme-apply: string,
    theme-active: string,
    appearance-section: string,
    appearance-themes: string,
    editor-section: string,
    language: string,
    font-size: string,
    line-height: string,
    tab-size: string,
    word-wrap: string,
    word-wrap-detail: string,
    vim-section: string,
    sync-clipboard: string,
    sync-clipboard-detail: string,
    startup-section: string,
    restore-last-session: string,
    restore-last-session-detail: string,
    show-launcher-on-startup: string,
    show-launcher-on-startup-detail: string,
    window-section: string,
    remember-window-geometry: string,
    remember-window-geometry-detail: string,
    blur-behind: string,
    blur-behind-detail: string,
    window-opacity: string,
    visual-section: string,
    use-mica: string,
    use-mica-detail: string,
    enable-animations: string,
    enable-animations-detail: string,
    cursor-glide: string,
    cursor-glide-detail: string,
    smooth-scroll: string,
    smooth-scroll-detail: string,
    cursor-blink: string,
    cursor-blink-detail: string,
    cursor-smear: string,
    cursor-smear-detail: string,
}

export component AppWindow inherits Window {
    title: root.ui-text.app-title;
    preferred-width: 1280px;
    preferred-height: 800px;

    in property <string> file-title: "Untitled";
    in property <string> file-path: "";
    in property <[EditorLine]> editor-lines;
    in property <[SelectionHighlightSegment]> selection-highlight-segments;
    in property <[SelectionHighlightShape]> selection-highlight-shapes;
    in property <[DocumentTab]> document-tabs;
    in property <string> status-text: "No note open";
    in property <string> status-right: "";
    in property <string> mode-text: "NORMAL";
    in property <int> cursor-line: 0;
    in property <int> cursor-column: 0;
    in property <int> previous-cursor-line: 0;
    in property <int> previous-cursor-column: 0;
    in property <string> cursor-prefix: "";
    in property <string> cursor-cell: " ";
    in property <string> cursor-suffix: "";
    in property <string> previous-cursor-prefix: "";
    in property <bool> cursor-block: true;
    in property <length> editor-left-padding: 14px;
    in property <float> editor-line-height: 17;
    in property <float> editor-font-size: 14;
    in property <string> editor-font-family: "Consolas";

    // Editor metrics contract
    property <length> gutter-width: 58px;
    property <length> content-padding-x: root.editor-left-padding;
    property <length> content-padding-y: 0px;
    property <length> editor-content-x: root.gutter-width + root.content-padding-x;
    property <length> editor-content-width: root.has-document
        ? max(editor-scroll.width - root.gutter-width - (root.content-padding-x * 2), 0px)
        : 0px;
    property <length> line-height-px: root.editor-line-height * 1px;
    property <length> cursor-prefix-width:
        root.cursor-prefix == "" ? 0px : cursor-prefix-measure.preferred-width;
    property <length> previous-cursor-prefix-width:
        root.previous-cursor-prefix == "" ? 0px : previous-cursor-prefix-measure.preferred-width;
    property <length> cursor-cell-width: max(cursor-cell-measure.preferred-width, 2px);
    property <length> cursor-target-x:
        root.editor-content-x + root.cursor-prefix-width;
    property <length> cursor-target-y:
        root.content-padding-y + root.cursor-line * root.line-height-px;
    property <length> previous-cursor-target-x:
        root.editor-content-x + root.previous-cursor-prefix-width;
    property <length> previous-cursor-target-y:
        root.content-padding-y + root.previous-cursor-line * root.line-height-px;
    property <length> cursor-width: root.cursor-block ? root.cursor-cell-width : 2px;
    property <length> cursor-height: root.line-height-px;

    // Shared animation duration expression
    property <int> glide-duration:
        root.enable-animations && root.enable-cursor-glide
            ? (root.cursor-animation-kind == 0 ? 0
                : (root.cursor-insert-mode ? root.anim-duration-insert
                    : (root.cursor-animation-kind == 1 ? root.anim-duration-short : root.anim-duration-normal)))
            : 0;
    in property <string> message: "";
    in property <bool> has-document: false;
    in property <bool> show-theme-panel: false;
    in property <bool> show-settings-panel: false;
    property <int> settings-section: 0;
    in property <[ThemeItem]> theme-items;
    in property <SettingsData> settings;
    in property <UiText> ui-text;
    in property <brush> theme-background: #0f1117;
    in property <brush> theme-background-alt: #161922;
    in property <brush> theme-surface: #1d2430;
    in property <brush> theme-border: #303848;
    in property <brush> theme-text: #d7dae0;
    in property <brush> theme-text-muted: #7f8490;
    in property <brush> theme-accent-primary: #7aa2f7;
    in property <brush> theme-accent-secondary: #bb9af7;
    in property <brush> theme-success: #9ece6a;
    in property <brush> theme-warning: #e0af68;
    in property <brush> theme-error: #f7768e;
    in property <brush> theme-cursor: #c0caf5;
    in property <brush> mode-color: #7aa2f7;
    in property <bool> enable-animations: true;
    in property <bool> enable-cursor-glide: true;
    in property <bool> enable-smooth-scroll: true;
    in property <bool> enable-cursor-blink: true;
    in property <bool> enable-cursor-smear: false;
    in property <bool> cursor-blink-visible: true;
    in property <bool> cursor-insert-mode: false;
    in property <int> anim-duration-short: 80;
    in property <int> anim-duration-normal: 120;
    in property <int> anim-duration-long: 180;
    in property <int> anim-duration-insert: 50;
    in property <int> viewport-top-line: 0;
    in property <int> cursor-animation-kind: 0;
    in property <int> cursor-smear-generation: 0;
    in property <int> scroll-animation-kind: 0;
    in property <int> search-match-current: 0;
    in property <int> search-match-total: 0;
    in property <string> search-match-label: "";

    // Cursor smear computed state
    property <bool> smear-is-horizontal:
        root.previous-cursor-line == root.cursor-line
        && root.previous-cursor-column != root.cursor-column;
    property <bool> smear-is-vertical:
        root.previous-cursor-column == root.cursor-column
        && root.previous-cursor-line != root.cursor-line;
    property <bool> smear-eligible: false;
    property <length> cursor-smear-x: root.cursor-target-x;
    property <length> cursor-smear-y: root.cursor-target-y;
    property <length> previous-cursor-smear-x: root.previous-cursor-target-x;
    property <length> previous-cursor-smear-y: root.previous-cursor-target-y;
    property <length> smear-x:
        root.smear-is-horizontal
            ? min(root.previous-cursor-smear-x, root.cursor-smear-x)
            : root.cursor-smear-x;
    property <length> smear-y:
        root.smear-is-vertical
            ? min(root.previous-cursor-smear-y, root.cursor-smear-y)
            : root.cursor-smear-y;
    property <length> smear-width:
        root.smear-is-horizontal
            ? abs(root.cursor-smear-x - root.previous-cursor-smear-x) + root.cursor-width
            : root.cursor-width;
    property <length> smear-height:
        root.smear-is-vertical
            ? abs(root.cursor-smear-y - root.previous-cursor-smear-y) + root.cursor-height
            : root.cursor-height;
    property <length> line-height: root.line-height-px;
    in property <float> smear-opacity: 0.0;
    in property <bool> show-cursor-smear: false;

    callback new-file();
    callback open-file();
    callback save-file();
    callback save-as-file();
    callback previous-document();
    callback next-document();
    callback switch-to-document(int);
    callback reorder-document(int, int);
    callback close-document(int);
    callback open-theme-panel();
    callback theme-preview(int);
    callback theme-apply(int);
    callback theme-panel-close();
    callback open-settings-panel();
    callback settings-panel-close();
    callback settings-adjust-font-size(int);
    callback settings-adjust-line-height(int);
    callback settings-adjust-tab-size(int);
    callback settings-cycle-language(int);
    callback settings-adjust-window-opacity(int);
    callback settings-toggle-word-wrap();
    callback settings-toggle-sync-clipboard();
    callback settings-toggle-restore-last-session();
    callback settings-toggle-show-launcher-on-startup();
    callback settings-toggle-remember-window-geometry();
    callback settings-toggle-blur-behind();
    callback settings-toggle-mica();
    callback settings-toggle-animations();
    callback settings-toggle-cursor-glide();
    callback settings-toggle-smooth-scroll();
    callback settings-toggle-cursor-blink();
    callback settings-toggle-cursor-smear();
    callback settings-reset-defaults();
    callback editor-key(string);
    callback editor-pointer-event(int, float, string);

    public function focus-editor() {
        editor-focus.focus();
    }

    public function scroll-to-cursor() {
        let line_height = root.line-height-px;
        let visible_height = editor-scroll.height;
        let viewport_target = root.viewport-top-line;
        let target_y = viewport_target * line_height;
        let cursor_y = root.cursor-line * line_height;

        if (cursor_y < target_y) {
            editor-scroll.viewport-y = -cursor_y;
        } else if (cursor_y + line_height > target_y + visible_height) {
            editor-scroll.viewport-y = -(cursor_y + line_height - visible_height);
        } else {
            editor-scroll.viewport-y = -target_y;
        }
    }

    background: root.theme-background;
    animate background {
        duration: root.anim-duration-normal * 1ms;
        easing: ease-out;
    }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 42px;
            background: root.theme-background-alt;
            animate background {
                duration: root.anim-duration-normal * 1ms;
                easing: ease-out;
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 12px;

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.theme-border.with_alpha(0.7);
                        background: root.theme-surface;

                        Text {
                            text: "▥";
                            color: root.theme-accent-primary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: root.ui-text.app-title;
                    color: root.theme-text;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                    letter-spacing: 0px;
                }

                VerticalLayout {
                    alignment: center;

                    files-btn := Rectangle {
                        width: 72px;
                        height: 28px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: files-touch.has-hover ? root.theme-border : root.theme-border.with_alpha(0.55);
                        background: files-touch.has-hover ? root.theme-surface : root.theme-background;
                        animate background {
                            duration: 120ms;
                            easing: ease-out;
                        }
                        animate border-color {
                            duration: 120ms;
                            easing: ease-out;
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 6px;

                            Text {
                                text: root.ui-text.files-menu;
                                color: root.theme-text;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: "⌄";
                                color: root.theme-text-muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }

                        files-touch := TouchArea {
                            clicked => {
                                files-popup.show();
                            }
                        }

                        files-popup := PopupWindow {
                            x: 0px;
                            y: 34px;
                            width: 180px;

                            Rectangle {
                                background: root.theme-background;
                                border-color: root.theme-border;
                                border-width: 1px;
                                border-radius: 6px;
                                drop-shadow-color: #000000.with_alpha(0.22);
                                drop-shadow-blur: 12px;
                                drop-shadow-offset-y: 4px;

                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 1px;

                                    CommandButton {
                                        text: root.ui-text.new-file;
                                        text-alignment: left;
                                        text-padding-left: 12px;
                                        background-color: root.theme-background;
                                        hover-color: root.theme-background-alt;
                                        command-border-color: transparent;
                                        text-color: root.theme-text;
                                        clicked => { root.new-file(); }
                                    }
                                    CommandButton {
                                        text: root.ui-text.open-file;
                                        text-alignment: left;
                                        text-padding-left: 12px;
                                        background-color: root.theme-background;
                                        hover-color: root.theme-background-alt;
                                        command-border-color: transparent;
                                        text-color: root.theme-text;
                                        clicked => { root.open-file(); }
                                    }
                                    Rectangle {
                                        height: 1px;
                                        background: root.theme-border.with_alpha(0.45);
                                    }
                                    CommandButton {
                                        text: root.ui-text.save-file;
                                        text-alignment: left;
                                        text-padding-left: 12px;
                                        background-color: root.theme-background;
                                        hover-color: root.theme-background-alt;
                                        command-border-color: transparent;
                                        text-color: root.theme-text;
                                        clicked => { root.save-file(); }
                                    }
                                    CommandButton {
                                        text: root.ui-text.save-as-file;
                                        text-alignment: left;
                                        text-padding-left: 12px;
                                        background-color: root.theme-background;
                                        hover-color: root.theme-background-alt;
                                        command-border-color: transparent;
                                        text-color: root.theme-text;
                                        clicked => { root.save-as-file(); }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                for control in ["−", "□", "×"]: Rectangle {
                    width: 44px;
                    height: 42px;
                    background: control-touch.has-hover ? root.theme-border.with_alpha(0.28) : transparent;
                    animate background {
                        duration: 120ms;
                        easing: ease-out;
                    }

                    Text {
                        text: control;
                        color: root.theme-text;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    control-touch := TouchArea {}
                }
            }
        }

        Rectangle {
            height: 1px;
            background: root.theme-border.with_alpha(0.35);
        }

        Rectangle {
            height: 34px;
            background: root.theme-background-alt;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 8px;

                ScrollView {
                    horizontal-stretch: 1;
                    height: 34px;
                    
                    HorizontalLayout {
                        spacing: 1px;
                        
                        for tab in root.document-tabs: Rectangle {
                            width: 150px;
                            height: 34px;
                            background: transparent;
                            
                            tab-card := Rectangle {
                                width: parent.width;
                                height: parent.height - 4px;
                                y: 4px;
                                x: tab-touch.pressed ? min(max(tab-touch.mouse-x - self.width / 2, -18px), 18px) : 0px;
                                background: tab-touch.pressed
                                    ? root.theme-border
                                    : (tab.is-active ? root.theme-background : (tab-touch.has-hover ? root.theme-background : transparent));
                                border-top-left-radius: 6px;
                                border-top-right-radius: 6px;
                                border-width: tab.is-active ? 1px : 0px;
                                border-color: root.theme-border.with_alpha(0.55);
                                opacity: tab-touch.pressed ? 0.98 : 1;
                                animate x {
                                    duration: 120ms;
                                    easing: ease-out;
                                }
                                animate background {
                                    duration: 140ms;
                                    easing: ease-out;
                                }
                                animate opacity {
                                    duration: 140ms;
                                    easing: ease-out;
                                }

                                // Active tab accent line
                                Rectangle {
                                    x: 6px;
                                    y: parent.height - 2px;
                                    width: parent.width - 12px;
                                    height: 2px;
                                    border-radius: 2px;
                                    background: tab.is-active ? root.theme-accent-primary : transparent;
                                    animate background {
                                        duration: 140ms;
                                        easing: ease-out;
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 6px;
                                    spacing: 4px;
                                    
                                    Text {
                                        text: "▣";
                                        color: root.theme-text-muted;
                                        font-size: 10px;
                                        width: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: tab.title + (tab.is-modified ? " ●" : "");
                                        color: tab.is-active ? root.theme-text : root.theme-text-muted;
                                        font-size: 12px;
                                        font-weight: tab.is-active ? 600 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        animate color {
                                            duration: 140ms;
                                            easing: ease-out;
                                        }
                                    }

                        VerticalLayout {
                                        alignment: center;
                                        
                                        close-btn := Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            border-radius: 4px;
                                            background: close-touch.has-hover ? root.theme-error.with_alpha(0.2) : transparent;
                                            opacity: tab.is-active || tab-touch.has-hover ? 1 : 0;
                                            animate background {
                                                duration: 120ms;
                                                easing: ease-out;
                                            }
                                            animate opacity {
                                                duration: 140ms;
                                                easing: ease-out;
                                            }

                                            Text {
                                                text: "×";
                                                font-size: 13px;
                                                color: close-touch.has-hover ? root.theme-error : root.theme-text-muted;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                animate color {
                                                    duration: 120ms;
                                                    easing: ease-out;
                                                }
                                            }

                                            close-touch := TouchArea {
                                                clicked => {
                                                    root.close-document(tab.index);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            
                            tab-touch := TouchArea {
                                width: parent.width - 24px;
                                clicked => {
                                    root.switch-to-document(tab.index);
                                }
                                moved => {
                                    if (!tab-touch.pressed) {
                                        return;
                                    }

                                    if (tab-touch.mouse-x < -24px) {
                                        root.reorder-document(tab.index, tab.index - 1);
                                    } else if (tab-touch.mouse-x > self.width + 24px) {
                                        root.reorder-document(tab.index, tab.index + 1);
                                    }
                                }
                            }
                        }
                    }
                }

                CommandButton {
                    width: 30px;
                    text: "+";
                    background-color: root.theme-background-alt;
                    hover-color: root.theme-background;
                    command-border-color: transparent;
                    text-color: root.theme-text-muted;
                    clicked => { root.new-file(); }
                }

                CommandButton {
                    width: 30px;
                    text: "⚙";
                    background-color: root.theme-background;
                    hover-color: root.theme-surface;
                    command-border-color: root.theme-border.with_alpha(0.55);
                    text-color: root.theme-text-muted;
                    clicked => {
                        root.settings-section = 0;
                        root.open-settings-panel();
                    }
                }

                Text {
                    text: root.message;
                    color: root.message == "" ? root.theme-text-muted : root.theme-success;
                    font-size: 12px;
                    font-weight: 500;
                    vertical-alignment: center;
                    opacity: root.message == "" ? 0.45 : 1;
                    animate opacity {
                        duration: 180ms;
                        easing: ease-out;
                    }
                }
            }
        }

        Rectangle {
            background: root.theme-background;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            editor-focus := FocusScope {
                width: 100%;
                height: 100%;

                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.editor-key("escape");
                    } else if (event.text == Key.Return) {
                        root.editor-key("return");
                    } else if (event.text == Key.Backspace) {
                        root.editor-key("backspace");
                    } else if (event.text == Key.Delete) {
                        root.editor-key("delete");
                    } else if (event.text == Key.LeftArrow) {
                        root.editor-key("left");
                    } else if (event.text == Key.RightArrow) {
                        root.editor-key("right");
                    } else if (event.text == Key.UpArrow) {
                        root.editor-key("up");
                    } else if (event.text == Key.DownArrow) {
                        root.editor-key("down");
                    } else if (event.modifiers.control && event.text == "r") {
                        root.editor-key("ctrl+r");
                    } else if (event.modifiers.control && event.text == "=") {
                        root.editor-key("ctrl+=");
                    } else if (event.modifiers.control && event.text == "+") {
                        root.editor-key("ctrl++");
                    } else if (event.modifiers.control && event.text == "-") {
                        root.editor-key("ctrl+-");
                    } else if (event.text == Key.Tab) {
                        root.editor-key("tab");
                    } else if (event.text == Key.Shift || event.text == Key.Control || event.text == Key.Alt || event.text == Key.Meta) {
                        // ignore modifier keys to prevent them from entering the buffer as unprintable characters
                    } else {
                        root.editor-key(event.text);
                    }

                    return accept;
                }

                    editor-viewport := Rectangle {
                    x: 0px;
                    y: 16px;
                    width: 100%;
                    height: parent.height - 32px;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: root.gutter-width;
                        height: 100%;
                        background: root.theme-background-alt;
                        animate background {
                            duration: root.anim-duration-normal * 1ms;
                            easing: ease-out;
                        }

                        // Gutter right border
                        Rectangle {
                            x: parent.width - 1px;
                            y: 0px;
                            width: 1px;
                            height: 100%;
                            background: root.theme-border.with_alpha(0.25);
                        }
                    }

                    Rectangle {
                        x: root.gutter-width;
                        y: 0px;
                        width: parent.width - root.gutter-width;
                        height: 100%;
                        background: root.theme-background;
                        animate background {
                            duration: root.anim-duration-normal * 1ms;
                            easing: ease-out;
                        }
                    }

                    Text {
                        x: root.editor-content-x;
                        y: 0px;
                        width: parent.width - root.gutter-width - (root.content-padding-x * 2);
                        height: parent.height;
                        text: root.ui-text.launcher-hint;
                        color: root.theme-text-muted.with_alpha(0.6);
                        font-family: root.editor-font-family;
                        font-size: root.editor-font-size * 1px;
                        visible: !root.has-document;
                    }

                    editor-scroll := ScrollView {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        visible: root.has-document;
                        animate viewport-y {
                            duration: (root.enable-animations && root.enable-smooth-scroll ? (root.scroll-animation-kind == 0 ? 0 : (root.scroll-animation-kind == 1 ? root.anim-duration-short : (root.scroll-animation-kind == 2 ? root.anim-duration-normal : root.anim-duration-long))) : 0) * 1ms;
                            easing: ease-out;
                        }

                        // Connected selection highlight overlay (behind text)
                        for shape in root.selection-highlight-shapes: Path {
                            property <length> cell-width: char-width-measure.preferred-width;
                            x: root.editor-content-x + shape.left-column * cell-width;
                            y: shape.top-line * root.line-height-px;
                            width: max(shape.width-cells * cell-width, cell-width);
                            height: max(shape.height-lines * root.line-height-px, root.line-height-px);
                            viewbox-width: max(shape.width-cells, 1);
                            viewbox-height: max(shape.height-lines, 1);
                            fit: fill;
                            commands: shape.path-data;
                            fill: root.theme-accent-primary.with_alpha(0.18);
                        }

                        VerticalLayout {
                            width: 100%;
                            spacing: 0px;

                            for line in root.editor-lines: Rectangle {
                                height: root.line-height-px;
                                width: 100%;
                                background: line.is-search-match ? root.theme-warning.with_alpha(0.16) : (line.is-cursor-line ? root.theme-surface.with_alpha(0.35) : transparent);

                                Text {
                                    x: 0px;
                                    y: 0px;
                                    width: 48px;
                                    height: root.line-height-px;
                                    text: line.number;
                                    color: line.is-cursor-line ? root.theme-text : root.theme-text-muted;
                                    font-family: root.editor-font-family;
                                    font-size: root.editor-font-size * 1px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    animate color {
                                        duration: 100ms;
                                        easing: ease-out;
                                    }
                                }

                                Text {
                                    x: root.editor-content-x;
                                    y: 0px;
                                    width: root.editor-content-width;
                                    height: root.line-height-px;
                                    text: line.text;
                                    color: root.theme-text;
                                    font-family: root.editor-font-family;
                                    font-size: root.editor-font-size * 1px;
                                    vertical-alignment: center;
                                    wrap: no-wrap;
                                }

                            }
                        }

                        // Character width calibration for empty-line selection rendering
                        char-width-measure := Text {
                            x: 0px;
                            y: 0px;
                            width: 0px;
                            height: 0px;
                            text: "X";
                            font-family: root.editor-font-family;
                            font-size: root.editor-font-size * 1px;
                            color: transparent;
                            vertical-alignment: center;
                            wrap: no-wrap;
                        }

                        // Cursor smear overlay (behind cursor)
                        Rectangle {
                            visible: false;
                            x: root.smear-x;
                            y: root.smear-y;
                            width: root.smear-width;
                            height: root.smear-height;
                            background: root.theme-cursor.with-alpha(root.smear-opacity);
                            animate opacity {
                                duration: 100ms;
                                easing: ease-out;
                            }
                        }

                        // Floating cursor overlay (single element for clean animation)
                        cursor-prefix-measure := Text {
                            x: 0px;
                            y: 0px;
                            width: 0px;
                            height: 0px;
                            text: root.cursor-prefix;
                            font-family: root.editor-font-family;
                            font-size: root.editor-font-size * 1px;
                            color: transparent;
                            vertical-alignment: center;
                            wrap: no-wrap;
                        }

                        previous-cursor-prefix-measure := Text {
                            x: 0px;
                            y: 0px;
                            width: 0px;
                            height: 0px;
                            text: root.previous-cursor-prefix;
                            font-family: root.editor-font-family;
                            font-size: root.editor-font-size * 1px;
                            color: transparent;
                            vertical-alignment: center;
                            wrap: no-wrap;
                        }

                        cursor-cell-measure := Text {
                            x: 0px;
                            y: 0px;
                            width: 0px;
                            height: 0px;
                            text: root.cursor-cell;
                            font-family: root.editor-font-family;
                            font-size: root.editor-font-size * 1px;
                            color: transparent;
                            vertical-alignment: center;
                            wrap: no-wrap;
                        }

                        Rectangle {
                            x: root.cursor-target-x;
                            y: root.cursor-target-y;
                            height: root.cursor-height;
                            width: root.has-document ? root.cursor-width : 0px;
                            background: root.cursor-block ? root.theme-cursor.with-alpha(0.45) : root.mode-color;
                            border-radius: 0px;
                            opacity: root.has-document && (!root.enable-cursor-blink || root.cursor-blink-visible) ? 1.0 : 0.0;
                            animate x {
                                duration: root.glide-duration * 1ms;
                                easing: ease-out;
                            }
                            animate opacity {
                                duration: 100ms;
                                easing: ease-out;
                            }
                        }
                    }

                }
            }

                    editor-touch := TouchArea {
                        width: parent.width - 15px; // Leave room for scrollbar
                        height: 100%;
                        clicked => {
                            editor-focus.focus();
                        }
                        scroll-event(event) => {
                            if (event.modifiers.control) {
                                if (event.delta-y > 0) {
                                    root.editor-key("ctrl+scroll-up");
                                } else if (event.delta-y < 0) {
                                    root.editor-key("ctrl+scroll-down");
                                }
                                return accept;
                            }
                            return reject;
                        }

                        pointer-event(event) => {
                            let physical_y = editor-touch.mouse-y - editor-scroll.viewport-y;
                            let line_index = Math.floor(physical_y / root.line-height-px);
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                root.editor-pointer-event(line_index, (editor-touch.mouse-x - root.gutter-width - root.content-padding-x) / 1px, "down");
                            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                                root.editor-pointer-event(line_index, (editor-touch.mouse-x - root.gutter-width - root.content-padding-x) / 1px, "up");
                            }
                        }

                        moved => {
                            if (editor-touch.pressed) {
                                let physical_y = editor-touch.mouse-y - editor-scroll.viewport-y;
                                let line_index = Math.floor(physical_y / root.line-height-px);
                                root.editor-pointer-event(line_index, (editor-touch.mouse-x - root.gutter-width - root.content-padding-x) / 1px, "move");
                            }
                        }

                        double-clicked => {
                            let physical_y = editor-touch.mouse-y - editor-scroll.viewport-y;
                            let line_index = Math.floor(physical_y / root.line-height-px);
                            root.editor-pointer-event(line_index, (editor-touch.mouse-x - root.gutter-width - root.content-padding-x) / 1px, "double_click");
                        }
                    }
        }

        // Status bar top border
        Rectangle {
            height: 1px;
            background: root.theme-border.with_alpha(0.35);
        }

        Rectangle {
            height: 26px;
            background: root.theme-background-alt;
            animate background {
                duration: root.anim-duration-normal * 1ms;
                easing: ease-out;
            }

            HorizontalLayout {
                spacing: 0px;

                Rectangle {
                    width: 100px;
                    background: root.mode-color;
                    animate background {
                        duration: root.anim-duration-normal * 1ms;
                        easing: ease-out;
                    }

                    Text {
                        text: root.mode-text;
                        color: root.theme-background;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        letter-spacing: 0.6px;
                    }
                }

                Text {
                    text: root.status-text;
                    color: root.theme-text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    horizontal-alignment: left;
                }

                Text {
                    text: root.search-match-label;
                    color: root.theme-accent-primary;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                    opacity: root.search-match-label == "" ? 0 : 1;
                    animate opacity {
                        duration: 140ms;
                        easing: ease-out;
                    }
                }

                Text {
                    text: root.status-right;
                    color: root.theme-text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        visible: root.show-theme-panel || self.opacity > 0.01;
        opacity: root.show-theme-panel ? 1 : 0;
        background: root.theme-background.with_alpha(0.68);
        animate opacity {
            duration: 180ms;
            easing: ease-out;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            enabled: root.show-theme-panel;
            clicked => {
                root.theme-panel-close();
            }
        }

        theme-panel-card := Rectangle {
            width: min(parent.width - 48px, 700px);
            height: min(parent.height - 80px, 348px);
            x: (parent.width - self.width) / 2;
            y: root.show-theme-panel ? max((parent.height - self.height) / 2, 24px) : max((parent.height - self.height) / 2 + 12px, 36px);
            opacity: root.show-theme-panel ? 1 : 0;
            border-width: 1px;
            border-color: root.theme-border.with_alpha(0.65);
            border-radius: 8px;
            background: root.theme-background;
            drop-shadow-color: #000000.with_alpha(0.18);
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 6px;
            clip: true;
            animate y {
                duration: 200ms;
                easing: ease-out;
            }
            animate opacity {
                duration: 160ms;
                easing: ease-out;
            }

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                HorizontalLayout {
                    height: 50px;
                    padding-left: 18px;
                    padding-right: 16px;
                    spacing: 12px;

                    Text {
                        text: root.ui-text.themes-title;
                        color: root.theme-text;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    SearchField {
                        width: 220px;
                        placeholder: "Search themes...";
                        field-background: root.theme-background;
                        field-border: root.theme-border;
                        field-text-muted: root.theme-text-muted;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    CommandButton {
                        width: 66px;
                        text: "Import";
                        background-color: root.theme-background-alt;
                        hover-color: root.theme-surface;
                        command-border-color: root.theme-border.with_alpha(0.65);
                        text-color: root.theme-text-muted;
                        clicked => { }
                    }

                    CommandButton {
                        width: 66px;
                        text: "Export";
                        background-color: root.theme-background-alt;
                        hover-color: root.theme-surface;
                        command-border-color: root.theme-border.with_alpha(0.65);
                        text-color: root.theme-text-muted;
                        clicked => { }
                    }

                    CommandButton {
                        width: 92px;
                        text: "+ New Theme";
                        background-color: root.theme-accent-primary;
                        hover-color: root.theme-accent-secondary;
                        command-border-color: root.theme-accent-primary;
                        text-color: root.theme-background;
                        clicked => { }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: root.theme-border.with_alpha(0.45);
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 0px;

                        for item in root.theme-items: Rectangle {
                            height: 40px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: item.is-preview ? root.theme-accent-primary.with_alpha(0.75) : (item.is-active ? root.theme-border.with_alpha(0.7) : root.theme-border.with_alpha(0.30));
                            background: item.is-preview || item.is-active ? root.theme-background-alt : root.theme-background;
                            animate background {
                                duration: 140ms;
                                easing: ease-out;
                            }
                            animate border-color {
                                duration: 140ms;
                                easing: ease-out;
                            }

                            theme-item-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    root.theme-preview(item.index);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;

                                VerticalLayout {
                                    alignment: center;

                                    Rectangle {
                                        width: 5px;
                                        height: 24px;
                                        border-radius: 2px;
                                        background: item.variant == "light" ? root.theme-warning.with_alpha(0.45) : root.theme-text.with_alpha(0.85);
                                        animate background {
                                            duration: 140ms;
                                            easing: ease-out;
                                        }
                                    }
                                }

                                Text {
                                    text: item.name;
                                    color: root.theme-text;
                                    font-size: 13px;
                                    font-weight: 700;
                                    width: 145px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Rectangle {
                                    height: 20px;
                                    min-width: 42px;
                                    border-radius: 4px;
                                    background: root.theme-background-alt;
                                    border-width: 1px;
                                    border-color: root.theme-border.with_alpha(0.35);

                                    Text {
                                        text: item.variant == "light" ? "Light" : "Dark";
                                        color: root.theme-text-muted;
                                        font-size: 10px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 20px;
                                    width: 96px;
                                    border-radius: 4px;
                                    background: root.theme-background-alt.with_alpha(0.75);

                                    Text {
                                        text: item.author;
                                        color: root.theme-text-muted;
                                        font-size: 10px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                CommandButton {
                                    width: 66px;
                                    text: root.ui-text.theme-preview;
                                    background-color: root.theme-background;
                                    hover-color: root.theme-surface;
                                    command-border-color: root.theme-border.with_alpha(0.55);
                                    text-color: root.theme-text-muted;
                                    clicked => { root.theme-preview(item.index); }
                                }

                                CommandButton {
                                    width: 64px;
                                    text: item.is-active ? root.ui-text.theme-active : root.ui-text.theme-apply;
                                    background-color: item.is-active ? root.theme-surface : root.theme-background-alt;
                                    hover-color: item.is-active ? root.theme-surface : root.theme-surface;
                                    command-border-color: root.theme-border.with_alpha(0.65);
                                    text-color: item.is-active ? root.theme-text-muted : root.theme-text;
                                    clicked => { root.theme-apply(item.index); }
                                }

                                Text {
                                    text: "⋯";
                                    color: root.theme-text-muted;
                                    font-size: 18px;
                                    width: 24px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: root.theme-border.with_alpha(0.35);
                }

                HorizontalLayout {
                    height: 48px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;

                    Text {
                        text: "7 themes";
                        color: root.theme-text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    CommandButton {
                        width: 70px;
                        text: root.ui-text.settings-close;
                        background-color: root.theme-background;
                        hover-color: root.theme-background-alt;
                        command-border-color: root.theme-border.with_alpha(0.65);
                        text-color: root.theme-text;
                        clicked => { root.theme-panel-close(); }
                    }
                }
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        visible: root.show-settings-panel || self.opacity > 0.01;
        opacity: root.show-settings-panel ? 1 : 0;
        background: root.theme-background.with_alpha(0.68);
        animate opacity {
            duration: 180ms;
            easing: ease-out;
        }

        TouchArea {
            width: 100%;
            height: 100%;
            enabled: root.show-settings-panel;
            clicked => {
                root.settings-panel-close();
            }
        }

        settings-panel-card := Rectangle {
            width: min(parent.width - 48px, 560px);
            height: min(parent.height - 80px, 486px);
            x: (parent.width - self.width) / 2;
            y: root.show-settings-panel ? 56px : 68px;
            opacity: root.show-settings-panel ? 1 : 0;
            border-width: 1px;
            border-color: root.theme-border.with_alpha(0.65);
            border-radius: 8px;
            background: root.theme-background;
            drop-shadow-color: #000000.with_alpha(0.18);
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 6px;
            clip: true;
            animate y {
                duration: 200ms;
                easing: ease-out;
            }
            animate opacity {
                duration: 160ms;
                easing: ease-out;
            }

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 8px;
                    height: 52px;
                    spacing: 8px;

                    Text {
                        text: root.ui-text.settings-title;
                        color: root.theme-text;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    CommandButton {
                        width: 34px;
                        text: "×";
                        background-color: root.theme-background;
                        hover-color: root.theme-background-alt;
                        command-border-color: transparent;
                        text-color: root.theme-text;
                        clicked => { root.settings-panel-close(); }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: root.theme-border.with_alpha(0.65);
                }

                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;

                    Rectangle {
                        width: 170px;
                        background: root.theme-background-alt.with_alpha(0.55);

                        VerticalLayout {
                            padding: 14px;
                            spacing: 4px;

                            SettingsNavItem {
                                icon: "⚙";
                                text: root.ui-text.visual-section;
                                active: root.settings-section == 0;
                                background-color: root.theme-background-alt;
                                hover-color: root.theme-border.with_alpha(0.35);
                                active-color: root.theme-border.with_alpha(0.55);
                                text-color: root.theme-text;
                                muted-color: root.theme-text-muted;
                                clicked => { root.settings-section = 0; }
                            }

                            SettingsNavItem {
                                icon: "✎";
                                text: root.ui-text.editor-section;
                                active: root.settings-section == 1;
                                background-color: root.theme-background-alt;
                                hover-color: root.theme-border.with_alpha(0.35);
                                active-color: root.theme-border.with_alpha(0.55);
                                text-color: root.theme-text;
                                muted-color: root.theme-text-muted;
                                clicked => { root.settings-section = 1; }
                            }

                            SettingsNavItem {
                                icon: "◇";
                                text: root.ui-text.appearance-section;
                                active: root.settings-section == 2;
                                background-color: root.theme-background-alt;
                                hover-color: root.theme-border.with_alpha(0.35);
                                active-color: root.theme-border.with_alpha(0.55);
                                text-color: root.theme-text;
                                muted-color: root.theme-text-muted;
                                clicked => { root.settings-section = 2; }
                            }

                            SettingsNavItem {
                                icon: "⌘";
                                text: root.ui-text.vim-section;
                                active: root.settings-section == 3;
                                background-color: root.theme-background-alt;
                                hover-color: root.theme-border.with_alpha(0.35);
                                active-color: root.theme-border.with_alpha(0.55);
                                text-color: root.theme-text;
                                muted-color: root.theme-text-muted;
                                clicked => { root.settings-section = 3; }
                            }

                            SettingsNavItem {
                                icon: "↗";
                                text: root.ui-text.startup-section;
                                active: root.settings-section == 4;
                                background-color: root.theme-background-alt;
                                hover-color: root.theme-border.with_alpha(0.35);
                                active-color: root.theme-border.with_alpha(0.55);
                                text-color: root.theme-text;
                                muted-color: root.theme-text-muted;
                                clicked => { root.settings-section = 4; }
                            }

                            SettingsNavItem {
                                icon: "ⓘ";
                                text: root.ui-text.window-section;
                                active: root.settings-section == 5;
                                background-color: root.theme-background-alt;
                                hover-color: root.theme-border.with_alpha(0.35);
                                active-color: root.theme-border.with_alpha(0.55);
                                text-color: root.theme-text;
                                muted-color: root.theme-text-muted;
                                clicked => { root.settings-section = 5; }
                            }
                        }
                    }

                    Rectangle {
                        width: 1px;
                        background: root.theme-border.with_alpha(0.55);
                    }

                    ScrollView {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;

                            Text {
                                text: root.ui-text.visual-section;
                                visible: root.settings-section == 0;
                                height: root.settings-section == 0 ? 18px : 0px;
                                color: root.theme-text;
                                font-size: 14px;
                                font-weight: 700;
                                letter-spacing: 0.2px;
                            }

                            ToggleRow {
                                visible: root.settings-section == 0;
                                height: root.settings-section == 0 ? 52px : 0px;
                                title: root.ui-text.use-mica;
                                detail: root.ui-text.use-mica-detail;
                                checked: root.settings.enable-mica;
                                row-background: root.theme-background;
                                row-hover: root.theme-background-alt;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                row-accent: root.theme-accent-primary;
                                toggled => { root.settings-toggle-mica(); }
                            }

                            ToggleRow {
                                visible: root.settings-section == 0;
                                height: root.settings-section == 0 ? 52px : 0px;
                                title: root.ui-text.enable-animations;
                                detail: root.ui-text.enable-animations-detail;
                                checked: root.settings.enable-animations;
                                row-background: root.theme-background;
                                row-hover: root.theme-background-alt;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                row-accent: root.theme-accent-primary;
                                toggled => { root.settings-toggle-animations(); }
                            }

                            Text {
                                text: root.ui-text.appearance-section;
                                visible: root.settings-section == 2;
                                height: root.settings-section == 2 ? 18px : 0px;
                                color: root.theme-text;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            Rectangle {
                                visible: root.settings-section == 2;
                                height: root.settings-section == 2 ? 48px : 0px;
                                border-radius: 6px;
                                background: touch-theme.has-hover ? root.theme-background-alt : root.theme-background;
                                border-width: 1px;
                                border-color: touch-theme.has-hover ? root.theme-border : root.theme-border.with_alpha(0.45);
                                animate background {
                                    duration: 140ms;
                                    easing: ease-out;
                                }
                                animate border-color {
                                    duration: 140ms;
                                    easing: ease-out;
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;

                                    Text {
                                        text: root.ui-text.appearance-themes;
                                        color: root.theme-text;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    VerticalLayout {
                                        alignment: center;

                                        Text {
                                            text: "›";
                                            color: root.theme-text-muted;
                                            font-size: 16px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                touch-theme := TouchArea {
                                    clicked => {
                                        root.open-theme-panel();
                                    }
                                }
                            }

                            Text {
                                text: root.ui-text.editor-section;
                                visible: root.settings-section == 1;
                                height: root.settings-section == 1 ? 18px : 0px;
                                color: root.theme-text;
                                font-size: 14px;
                                font-weight: 700;
                                letter-spacing: 0.2px;
                            }

                            NumericSettingRow {
                                visible: root.settings-section == 1;
                                height: root.settings-section == 1 ? 48px : 0px;
                                title: root.ui-text.language;
                                value: root.settings.language-label;
                                row-background: root.theme-background;
                                row-hover: root.theme-border;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                decrement => { root.settings-cycle-language(-1); }
                                increment => { root.settings-cycle-language(1); }
                            }

                            NumericSettingRow {
                                visible: root.settings-section == 1;
                                height: root.settings-section == 1 ? 48px : 0px;
                                title: root.ui-text.font-size;
                                value: root.settings.font-size-label;
                                row-background: root.theme-background;
                                row-hover: root.theme-border;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                decrement => { root.settings-adjust-font-size(-1); }
                                increment => { root.settings-adjust-font-size(1); }
                            }

                            NumericSettingRow {
                                visible: root.settings-section == 1;
                                height: root.settings-section == 1 ? 48px : 0px;
                                title: root.ui-text.line-height;
                                value: root.settings.line-height-label;
                                row-background: root.theme-background;
                                row-hover: root.theme-border;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                decrement => { root.settings-adjust-line-height(-1); }
                                increment => { root.settings-adjust-line-height(1); }
                            }

                            NumericSettingRow {
                                visible: root.settings-section == 1;
                                height: root.settings-section == 1 ? 48px : 0px;
                                title: root.ui-text.tab-size;
                                value: root.settings.tab-size-label;
                                row-background: root.theme-background;
                                row-hover: root.theme-border;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                decrement => { root.settings-adjust-tab-size(-1); }
                                increment => { root.settings-adjust-tab-size(1); }
                            }

                            ToggleRow {
                                visible: root.settings-section == 1;
                                height: root.settings-section == 1 ? 52px : 0px;
                                title: root.ui-text.word-wrap;
                                detail: root.ui-text.word-wrap-detail;
                                checked: root.settings.word-wrap;
                                row-background: root.theme-background;
                                row-hover: root.theme-background-alt;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                row-accent: root.theme-accent-primary;
                                toggled => { root.settings-toggle-word-wrap(); }
                            }

                            ToggleRow {
                                visible: root.settings-section == 0;
                                height: root.settings-section == 0 ? 52px : 0px;
                                title: root.ui-text.cursor-glide;
                                detail: root.ui-text.cursor-glide-detail;
                                checked: root.settings.enable-cursor-glide;
                                row-background: root.theme-background;
                                row-hover: root.theme-background-alt;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                row-accent: root.theme-accent-primary;
                                toggled => { root.settings-toggle-cursor-glide(); }
                            }

                            ToggleRow {
                                visible: root.settings-section == 0;
                                height: root.settings-section == 0 ? 52px : 0px;
                                title: root.ui-text.smooth-scroll;
                                detail: root.ui-text.smooth-scroll-detail;
                                checked: root.settings.enable-smooth-scroll;
                                row-background: root.theme-background;
                                row-hover: root.theme-background-alt;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                row-accent: root.theme-accent-primary;
                                toggled => { root.settings-toggle-smooth-scroll(); }
                            }

                            ToggleRow {
                                visible: root.settings-section == 1;
                                height: root.settings-section == 1 ? 52px : 0px;
                                title: root.ui-text.cursor-blink;
                                detail: root.ui-text.cursor-blink-detail;
                                checked: root.settings.enable-cursor-blink;
                                row-background: root.theme-background;
                                row-hover: root.theme-background-alt;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                row-accent: root.theme-accent-primary;
                                toggled => { root.settings-toggle-cursor-blink(); }
                            }

                            ToggleRow {
                                visible: root.settings-section == 0;
                                height: root.settings-section == 0 ? 52px : 0px;
                                title: root.ui-text.cursor-smear;
                                detail: root.ui-text.cursor-smear-detail;
                                checked: root.settings.enable-cursor-smear;
                                row-background: root.theme-background;
                                row-hover: root.theme-background-alt;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                row-accent: root.theme-accent-primary;
                                toggled => { root.settings-toggle-cursor-smear(); }
                            }

                            Text {
                                text: root.ui-text.vim-section;
                                visible: root.settings-section == 3;
                                height: root.settings-section == 3 ? 18px : 0px;
                                color: root.theme-text;
                                font-size: 14px;
                                font-weight: 700;
                                letter-spacing: 0.2px;
                            }

                            ToggleRow {
                                visible: root.settings-section == 3;
                                height: root.settings-section == 3 ? 52px : 0px;
                                title: root.ui-text.sync-clipboard;
                                detail: root.ui-text.sync-clipboard-detail;
                                checked: root.settings.sync-clipboard;
                                row-background: root.theme-background;
                                row-hover: root.theme-background-alt;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                row-accent: root.theme-accent-primary;
                                toggled => { root.settings-toggle-sync-clipboard(); }
                            }

                            Text {
                                text: root.ui-text.startup-section;
                                visible: root.settings-section == 4;
                                height: root.settings-section == 4 ? 18px : 0px;
                                color: root.theme-text;
                                font-size: 14px;
                                font-weight: 700;
                                letter-spacing: 0.2px;
                            }

                            ToggleRow {
                                visible: root.settings-section == 4;
                                height: root.settings-section == 4 ? 52px : 0px;
                                title: root.ui-text.restore-last-session;
                                detail: root.ui-text.restore-last-session-detail;
                                checked: root.settings.restore-last-session;
                                row-background: root.theme-background;
                                row-hover: root.theme-background-alt;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                row-accent: root.theme-accent-primary;
                                toggled => { root.settings-toggle-restore-last-session(); }
                            }

                            ToggleRow {
                                visible: root.settings-section == 4;
                                height: root.settings-section == 4 ? 52px : 0px;
                                title: root.ui-text.show-launcher-on-startup;
                                detail: root.ui-text.show-launcher-on-startup-detail;
                                checked: root.settings.show-launcher-on-startup;
                                row-background: root.theme-background;
                                row-hover: root.theme-background-alt;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                row-accent: root.theme-accent-primary;
                                toggled => { root.settings-toggle-show-launcher-on-startup(); }
                            }

                            Text {
                                text: root.ui-text.window-section;
                                visible: root.settings-section == 5;
                                height: root.settings-section == 5 ? 18px : 0px;
                                color: root.theme-text;
                                font-size: 14px;
                                font-weight: 700;
                                letter-spacing: 0.2px;
                            }

                            ToggleRow {
                                visible: root.settings-section == 5;
                                height: root.settings-section == 5 ? 52px : 0px;
                                title: root.ui-text.remember-window-geometry;
                                detail: root.ui-text.remember-window-geometry-detail;
                                checked: root.settings.remember-window-geometry;
                                row-background: root.theme-background;
                                row-hover: root.theme-background-alt;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                row-accent: root.theme-accent-primary;
                                toggled => { root.settings-toggle-remember-window-geometry(); }
                            }

                            ToggleRow {
                                visible: root.settings-section == 5;
                                height: root.settings-section == 5 ? 52px : 0px;
                                title: root.ui-text.blur-behind;
                                detail: root.ui-text.blur-behind-detail;
                                checked: root.settings.blur-behind;
                                row-background: root.theme-background;
                                row-hover: root.theme-background-alt;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                row-accent: root.theme-accent-primary;
                                toggled => { root.settings-toggle-blur-behind(); }
                            }

                            NumericSettingRow {
                                visible: root.settings-section == 5;
                                height: root.settings-section == 5 ? 48px : 0px;
                                title: root.ui-text.window-opacity;
                                value: root.settings.window-opacity-label;
                                row-background: root.theme-background;
                                row-hover: root.theme-border;
                                row-border: root.theme-border;
                                row-text: root.theme-text;
                                row-text-muted: root.theme-text-muted;
                                decrement => { root.settings-adjust-window-opacity(-5); }
                                increment => { root.settings-adjust-window-opacity(5); }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: root.theme-border.with_alpha(0.45);
                }

                HorizontalLayout {
                    height: 56px;
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 8px;

                    CommandButton {
                        width: 126px;
                        text: "Reset to Defaults";
                        background-color: root.theme-background;
                        hover-color: root.theme-background-alt;
                        command-border-color: root.theme-border.with_alpha(0.65);
                        text-color: root.theme-text;
                        clicked => { root.settings-reset-defaults(); }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    CommandButton {
                        width: 74px;
                        text: root.ui-text.theme-cancel;
                        background-color: root.theme-background;
                        hover-color: root.theme-background-alt;
                        command-border-color: root.theme-border.with_alpha(0.65);
                        text-color: root.theme-text;
                        clicked => { root.settings-panel-close(); }
                    }

                    CommandButton {
                        width: 74px;
                        text: "Save";
                        background-color: root.theme-accent-primary;
                        hover-color: root.theme-accent-secondary;
                        command-border-color: root.theme-accent-primary;
                        text-color: root.theme-background;
                        clicked => { root.settings-panel-close(); }
                    }
                }
            }
        }

        Rectangle {
            x: max((parent.width - self.width) / 2, 24px);
            y: settings-panel-card.y + settings-panel-card.height + 54px;
            width: min(parent.width - 48px, 600px);
            height: 206px;
            visible: root.show-settings-panel && parent.height > 760px;
            background: transparent;

            VerticalLayout {
                spacing: 12px;

                Text {
                    text: "Cursor Smear Behavior";
                    color: root.theme-text;
                    font-size: 14px;
                    font-weight: 700;
                }

                HorizontalLayout {
                    height: 126px;
                    spacing: 8px;

                    CursorSmearDemoCard {
                        horizontal-stretch: 1;
                        title: "Horizontal Smear";
                        subtitle: "Fast horizontal movement";
                        code: "1   const items = getItems();\n2   process(items); ▌\n3   return items;";
                        editor-font: root.editor-font-family;
                        card-background: root.theme-background;
                        card-border: root.theme-border;
                        card-text: root.theme-text;
                        card-muted: root.theme-text-muted;
                    }

                    CursorSmearDemoCard {
                        horizontal-stretch: 1;
                        title: "Vertical Smear";
                        subtitle: "Fast vertical movement";
                        code: "1   if (user.isActive) {\n2     loadDashboard();\n3     loadNotifications();\n4     loadSettings();\n5   }";
                        editor-font: root.editor-font-family;
                        card-background: root.theme-background;
                        card-border: root.theme-border;
                        card-text: root.theme-text;
                        card-muted: root.theme-text-muted;
                    }

                    CursorSmearDemoCard {
                        horizontal-stretch: 1;
                        title: "No Smear";
                        subtitle: "Large jumps & insert mode";
                        code: "1   function save() {\n2     validate();\n3\n4     // insert mode\n5     const data = ▌";
                        editor-font: root.editor-font-family;
                        card-background: root.theme-background;
                        card-border: root.theme-border;
                        card-text: root.theme-text;
                        card-muted: root.theme-text-muted;
                    }
                }

                Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: root.theme-border.with_alpha(0.45);
                    background: root.theme-background-alt.with_alpha(0.55);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        Text {
                            text: "ⓘ";
                            color: root.theme-text-muted;
                            font-size: 14px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "Cursor smear is disabled for large jumps and while in insert mode.";
                            color: root.theme-text-muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
